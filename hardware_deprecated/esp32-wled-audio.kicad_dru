(version 1)

# BQ24392 UQFN-10: the library footprint's corner pads sit 0.11 mm apart.
(rule "U4 pad-to-pad"
	(condition "A.Reference == 'U4' && B.Reference == 'U4'")
	(constraint clearance (min 0.1)))

# Tracks escaping the same package need 0.1 mm to its neighbouring pads.
(rule "U4 pad-to-track"
	(condition "A.Reference == 'U4' || B.Reference == 'U4'")
	(constraint clearance (min 0.1)))
